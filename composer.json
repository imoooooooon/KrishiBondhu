{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "krishibondhu/krishibondhu",
    "type": "project",
    "description": "Krishi Bondhu - CSE470 group project (BRAC University), Laravel MVC application.",
    "keywords": [
        "laravel",
        "cse470"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi",
            "@fonts"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan serve"
        ],
        "lint": [
            "pint --test"
        ],
        "format": [
            "pint"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "check": [
            "@composer validate --strict",
            "@lint",
            "@php artisan about --only=environment",
            "@php artisan db:show --ansi",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "fonts": [
            "@php scripts/install-fonts.php"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "setup": "Create .env from .env.example and generate this computer's app key",
        "dev": "Start the local development server",
        "lint": "Check PHP formatting (Laravel Pint)",
        "format": "Fix PHP formatting",
        "test": "Run the test suite against the test database",
        "check": "Run all local checks",
        "fonts": "Copy the locally downloaded Li Ador Noirrit font into public/ (not committed; see docs/first-time-setup.md)"
    }
}
